# Public app URL. Used for OAuth redirects, Stripe return URLs, and referral links.
APP_URL=http://127.0.0.1:43123
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Session encryption. Generate a long random string before production.
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated operator emails for /admin.
ADMIN_EMAILS=

# Local file database directory. Used only when DATABASE_URL is unset.
UNNEPO_DATA_DIR=.data

# Hosted Postgres. On Vercel this is required. A direct connection creates the app_state table itself.
# Supabase: use the database password connection string, or set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# and run supabase/migrations/0002_app_state.sql.
DATABASE_URL=

# Show the labeled sample directory when Apollo is not configured. Never mixed into live results.
UNNEPO_SAMPLE_DIRECTORY=true

# Expose verification and reset links in the API response. Keep false in production.
UNNEPO_DEV_VERIFY=false

# Supabase. Server-only. Do not prefix the service role with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credit rules
SIGNUP_CREDITS=25
UNLOCK_CREDIT_COST=1
REFERRAL_CREDITS=50
REFERRAL_DAILY_CAP=10
GRIND_PRICE_CENTS=1900
GRIND_MONTHLY_CREDITS=200
PACK_PRICE_CENTS=5000
PACK_CREDITS=500

# Spend caps, in cents. Sample-directory lookups cost 0.
DAILY_GLOBAL_SPEND_CENTS=2500
DAILY_USER_SPEND_CENTS=200
AI_HOURLY_LIMIT=30
AI_DAILY_LIMIT=100

# Estimated unit costs until a provider invoice says otherwise.
APOLLO_SEARCH_COST_CENTS=1
APOLLO_ENRICH_COST_CENTS=8
HOSTING_MONTHLY_CENTS=0
EMAIL_INFRA_MONTHLY_CENTS=0
AI_FAST_INPUT_CENTS_PER_MILLION=100
AI_FAST_OUTPUT_CENTS_PER_MILLION=500
AI_STRONG_INPUT_CENTS_PER_MILLION=300
AI_STRONG_OUTPUT_CENTS_PER_MILLION=1500

# Providers. All server-side.
APOLLO_API_KEY=
# Cheap model for outreach emails. Haiku is the one the composer calls.
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GRIND=
STRIPE_PRICE_PACK=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

RESEND_API_KEY=
RESEND_FROM=Unnepo <noreply@your-domain.com>
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# PostHog project key stays server-side here. Sentry DSN stays server-side.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
