{
  "manifest_version": 3,
  "name": "Unnepo",
  "short_name": "Unnepo",
  "version": "1.3",
  "version_name": "1.003",
  "description": "Fills job and internship applications from your Unnepo profile, in your own browser. You approve every submit.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Unnepo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://unneponew.vercel.app/extension/connect*",
        "http://localhost/extension/connect*"
      ],
      "js": [
        "content/connect.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.bamboohr.com/*",
        "https://*.paycomonline.net/*",
        "https://*.paylocity.com/*",
        "https://*.ultipro.com/*",
        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.breezy.hr/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://ats.rippling.com/*",
        "https://*.applytojob.com/*",
        "https://*.dayforcehcm.com/*"
      ],
      "js": [
        "content/launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "include_globs": [
        "*apply*",
        "*application*",
        "*career*",
        "*/job/*",
        "*/jobs*",
        "*recruit*",
        "*hiring*",
        "*/position*",
        "*opening*",
        "*vacanc*"
      ],
      "exclude_matches": [
        "https://*.linkedin.com/*",
        "https://unneponew.vercel.app/*"
      ],
      "js": [
        "content/launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
