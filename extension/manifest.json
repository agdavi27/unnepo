{
  "manifest_version": 3,
  "name": "Unnepo",
  "short_name": "Unnepo",
  "version": "0.1.0",
  "description": "Fills job and internship applications from your Unnepo profile, in your own browser. You approve every submit.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Unnepo",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab",
    "webRequest"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://unneponew.vercel.app/extension/connect*",
        "http://localhost/extension/connect*"
      ],
      "js": [
        "content/connect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
