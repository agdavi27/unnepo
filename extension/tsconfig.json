{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["chrome"],
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/**/*.ts"]
}
